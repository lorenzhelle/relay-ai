# Copy to .env and fill in your Supabase project values.
# Never commit .env — it contains secrets.

# From Supabase project → Settings → API
# "Publishable key" (formerly "anon key") — starts with sb_publishable_ in newer projects
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key-here

# Channel ID — copy from the iOS app's Settings screen (⋯ button) after first launch.
# This links this agent instance to your iOS device.
CHANNEL_ID=
