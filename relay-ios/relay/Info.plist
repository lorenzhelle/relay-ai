<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>audio</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Relay records your voice so you can capture thoughts and send them to Claude Code on your Mac.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Relay transcribes your voice recordings locally so your words can be sent as text to Claude Code.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<key>SUP_URL</key>
	<string>$(SUP_URL)</string>
	<key>SUP_ANON_KEY</key>
	<string>$(SUP_ANON_KEY)</string>
</dict>
</plist>
